{
  "meta": {
    "currency": "KRW",
    "money_unit": "integer_won",
    "time_unit": "integer_minutes",
    "rounding_rule": "sum(minutes * hourly_rate) over records, then integer rounding: (numerator + 30) // 60 for positive numerator. Python round() is NOT used (banker's rounding, not 사사오입). hourly_rate is won per hour.",
    "confirmed_zero_vs_null": "null = unconfirmed/missing; 0 = user-confirmed zero. do not fill null with 0.",
    "payment_sum_rule": "sum only user-confirmed wage allocations; handle duplicate/split/cash/unallocated separately.",
    "planned_not_summed": "do not sum planned work or payment promises as actual.",
    "separations": [
      "statement_internal_arithmetic",
      "payment_difference",
      "base_pay_reference_arithmetic"
    ],
    "excluded": [
      "arbitrary_hourly_rate_back_calculation",
      "minimum_wage_auto_substitution",
      "statutory_allowance_determination",
      "difference_auto_bill_confirmation",
      "duplicate_summation"
    ],
    "flow": [
      "original",
      "user_confirmation",
      "comparison_arithmetic",
      "explanation_questions",
      "bilingual_correction_impact",
      "answer_complement_request_modified_statement",
      "user_confirmation_then_issue_summary",
      "answer_additional_payment_reflection",
      "user_termination_status"
    ]
  },
