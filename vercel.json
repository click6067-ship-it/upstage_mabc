{
  "version": 2,
  "builds": [
    {
      "src": "frontend/dist/**",
      "use": "@vercel/static"
    },
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "status": 307,
      "headers": {
        "Location": "https://paychecker-app.vercel.app/"
      }
    }
  ]
}
